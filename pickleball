export default function BaoliangPickleballStudentPortal() {
  const [selectedGroup, setSelectedGroup] = useState("regular");
  const [selectedClass, setSelectedClass] = useState(classGroups.regular.classes[0]);
  const [selectedStudentName, setSelectedStudentName] = useState("");

  const classes = classGroups[selectedGroup as keyof typeof classGroups].classes;

  const filteredStudents = useMemo(() => {
    return students.filter(
      (student) => student.group === selectedGroup && student.className === selectedClass
    );
  }, [selectedGroup, selectedClass]);

  const selectedStudent = useMemo(() => {
    return filteredStudents.find((student) => student.name === selectedStudentName) || filteredStudents[0];
  }, [filteredStudents, selectedStudentName]);

  const remainingLessons = selectedStudent.totalLessons - selectedStudent.usedLessons;
  const progress = Math.round((selectedStudent.usedLessons / selectedStudent.totalLessons) * 100);

  const handleGroupChange = (group: string) => {
    setSelectedGroup(group);
    const firstClass = classGroups[group as keyof typeof classGroups].classes[0];
    setSelectedClass(firstClass);
    const firstStudent = students.find((student) => student.group === group && student.className === firstClass);
    setSelectedStudentName(firstStudent?.name || "");
  };

  const handleClassChange = (className: string) => {
    setSelectedClass(className);
    const firstStudent = students.find((student) => student.group === selectedGroup && student.className === className);
    setSelectedStudentName(firstStudent?.name || "");
  };

