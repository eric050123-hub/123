            <Ticket size={16} /> 寶亮 Pickleball Club
          </div>
          <h1 className="text-3xl font-bold tracking-tight md:text-5xl">學員課程查詢系統</h1>
          <p className="mt-3 max-w-2xl text-slate-300">
            請先選擇班級類型，再選擇班級與姓名，即可查看剩餘堂數、上課紀錄與課程規則。
          </p>
        </motion.div>

        <Card className="mb-5 rounded-3xl border-white/10 bg-white/10 text-white shadow-xl backdrop-blur">
          <CardContent className="p-6">
            <h2 className="mb-4 flex items-center gap-2 text-xl font-bold">
              <Search className="text-lime-300" /> 查詢學員資料
            </h2>

            <div className="mb-5 grid gap-4 md:grid-cols-2">
              {Object.entries(classGroups).map(([key, group]) => (
                <button
                  key={key}
                  onClick={() => handleGroupChange(key)}
                  className={`rounded-3xl border p-5 text-left transition ${
                    selectedGroup === key
                      ? "border-lime-300 bg-lime-300 text-slate-950"
                      : "border-white/10 bg-slate-900/70 hover:border-lime-300/60"
                  }`}
