                  {classes.map((className) => (
                    <option key={className} value={className}>{className}</option>
                  ))}
                </select>
              </label>

              <label className="block">
                <span className="mb-2 block text-sm text-slate-300">選擇學員</span>
                <select
                  value={selectedStudent?.name || ""}
                  onChange={(event) => setSelectedStudentName(event.target.value)}
                  className="w-full rounded-2xl border border-white/10 bg-slate-900 p-4 text-white outline-none ring-lime-300 focus:ring-2"
