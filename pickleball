                  <span className="w-fit rounded-full bg-lime-300 px-3 py-1 text-sm font-bold text-slate-950">
                    剩餘 {remainingLessons} 堂
                  </span>
                </div>

                <div className="grid gap-4 md:grid-cols-4">
                  <InfoCard label="總堂數" value={`${selectedStudent.totalLessons} 堂`} />
                  <InfoCard label="已使用" value={`${selectedStudent.usedLessons} 堂`} />
                  <InfoCard label="剩餘" value={`${remainingLessons} 堂`} highlight />
                  <InfoCard label="期限" value={selectedStudent.deadline} />
                </div>

                <div className="mt-6">
                  <div className="mb-2 flex justify-between text-sm text-slate-300">
                    <span>使用進度</span>
                    <span>{progress}%</span>
                  </div>
                  <div className="h-3 overflow-hidden rounded-full bg-slate-800">
                    <div className="h-full rounded-full bg-lime-300" style={{ width: `${progress}%` }} />
                  </div>
                </div>
              </CardContent>
            </Card>

            <Card className="rounded-3xl border-white/10 bg-white/10 text-white shadow-xl backdrop-blur">
              <CardContent className="p-6">
                <h2 className="flex items-center gap-2 text-xl font-bold">
                  <Megaphone className="text-lime-300" /> 最新公告
                </h2>
                <div className="mt-4 space-y-3">
                  {notices.map((notice, index) => (
                    <div key={index} className="rounded-2xl bg-slate-900/70 p-4 text-sm text-slate-200">
                      {notice}
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          </div>
        )}

        <div className="mt-5 grid gap-5 lg:grid-cols-3">
          <Card className="rounded-3xl border-white/10 bg-white/10 text-white shadow-xl backdrop-blur lg:col-span-2">
            <CardContent className="p-6">
              <h2 className="mb-5 flex items-center gap-2 text-xl font-bold">
                <CalendarDays className="text-lime-300" /> 本週課程資訊
              </h2>
              <div className="space-y-4">
                {availableClasses.map((item) => (
                  <div key={item.title} className="rounded-3xl border border-white/10 bg-slate-900/70 p-5">
                    <div className="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                      <div>
                        <h3 className="text-lg font-bold">{item.title}</h3>
                        <div className="mt-2 flex flex-wrap gap-3 text-sm text-slate-300">
                          <span className="flex items-center gap-1"><Clock size={15} /> {item.time}</span>
                          <span className="flex items-center gap-1"><MapPin size={15} /> {item.location}</span>
                          <span className="flex items-center gap-1"><User size={15} /> {item.enrolled}/{item.capacity} 人</span>
                        </div>
                      </div>
                      <Button className="rounded-2xl bg-lime-300 px-6 py-5 font-bold text-slate-950 hover:bg-lime-200">
                        查看報名資訊
                      </Button>
                    </div>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>

          <Card className="rounded-3xl border-white/10 bg-white/10 text-white shadow-xl backdrop-blur">
            <CardContent className="p-6">
              <h2 className="mb-5 flex items-center gap-2 text-xl font-bold">
                <ClipboardList className="text-lime-300" /> 上課紀錄
              </h2>
              <div className="space-y-3">
                {selectedStudent.records.length > 0 ? (
                  selectedStudent.records.map((date, index) => (
                    <div key={index} className="rounded-2xl bg-slate-900/70 p-4">
                      <div className="flex items-center justify-between">
                        <div>
                          <div className="font-bold">{selectedStudent.className}</div>
                          <div className="mt-1 text-sm text-slate-300">{date}</div>
                        </div>
                        <CheckCircle2 className="text-lime-300" />
                      </div>
                    </div>
                  ))
                ) : (
                  <div className="rounded-2xl bg-slate-900/70 p-4 text-sm text-slate-300">
                    目前尚無上課紀錄
                  </div>
                )}
              </div>
            </CardContent>
          </Card>
        </div>

        <Card className="mt-5 rounded-3xl border-white/10 bg-white/10 text-white shadow-xl backdrop-blur">
          <CardContent className="p-6">
            <h2 className="mb-4 flex items-center gap-2 text-xl font-bold">
              <Info className="text-lime-300" /> 團體班課程規則
            </h2>
            <div className="grid gap-3 md:grid-cols-5">
              <RuleItem text="5堂課制" />
              <RuleItem text="6週內完成" />
              <RuleItem text="每週採報名制" />
              <RuleItem text="額滿依報名順序" />
              <RuleItem text="逾期不順延" />
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}

function InfoCard({ label, value, highlight = false }: { label: string; value: string; highlight?: boolean }) {
  return (
    <div className={`rounded-3xl p-4 ${highlight ? "bg-lime-300 text-slate-950" : "bg-slate-900/70"}`}>
      <div className={`text-sm ${highlight ? "text-slate-700" : "text-slate-400"}`}>{label}</div>
      <div className="mt-1 text-xl font-black">{value}</div>
    </div>
  );
}

function RuleItem({ text }: { text: string }) {
  return (
    <div className="flex items-center gap-2 rounded-2xl bg-slate-900/70 p-4 text-sm font-medium text-slate-200">
      <CheckCircle2 size={18} className="shrink-0 text-lime-300" />
      {text}
    </div>
  );
}
