                  <div className="flex items-center gap-2 text-xl font-black">
                    <Users size={22} /> {group.label}
                  </div>
                  <p className={`mt-2 text-sm ${selectedGroup === key ? "text-slate-700" : "text-slate-300"}`}>
                    {group.description}
                  </p>
                </button>
              ))}
            </div>

            <div className="grid gap-4 md:grid-cols-2">
              <label className="block">
                <span className="mb-2 block text-sm text-slate-300">選擇班級</span>
                <select
                  value={selectedClass}
                  onChange={(event) => handleClassChange(event.target.value)}
                  className="w-full rounded-2xl border border-white/10 bg-slate-900 p-4 text-white outline-none ring-lime-300 focus:ring-2"
