                  {filteredStudents.map((student) => (
                    <option key={student.name} value={student.name}>{student.displayName}</option>
                  ))}
                </select>
              </label>
            </div>
          </CardContent>
        </Card>

        {selectedStudent && (
          <div className="grid gap-5 md:grid-cols-3">
